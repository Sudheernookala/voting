{
  "rules": {
    "admins": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".write": "auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists()",
      "$email": {
        ".validate": "newData.isBoolean() && $email.matches(/^[^@]+@[^@]+$/)"
      }
    },
    "meetingIndex": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists()",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists() && (!data.exists() || !newData.exists())",
        ".validate": "newData.isNumber()"
      }
    },
    "hostMeetings": {
      "$email": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') === $email",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') === $email",
        "$code": {
          ".validate": "newData.hasChildren(['title', 'key', 'createdAt'])"
        }
      }
    },
    "hostSecrets": {
      "$code": {
        ".read": false,
        ".write": "auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists() && (!data.exists() || !newData.exists())",
        ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 64"
      }
    },
    "meetings": {
      "$code": {
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && $code.matches(/^[A-Z2-9]{6}$/)",
          ".validate": "newData.hasChildren(['title', 'createdAt']) && newData.parent().child('hosts/' + auth.uid).exists()",
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "hosts": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('hostSecrets/' + $code).val()"
          }
        },
        "categories": {
          ".read": "auth != null",
          "$cat": {
            ".write": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
            ".validate": "newData.hasChildren(['title', 'status', 'createdAt', 'options'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "status": {
              ".validate": "newData.val() === 'draft' || newData.val() === 'open' || newData.val() === 'closed'"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "options": {
              "$opt": {
                ".validate": "newData.hasChildren(['label', 'order'])",
                "label": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
                },
                "order": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            },
            "multi": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 10 && newData.val() % 1 === 0"
            },
            "reveal": {
              ".validate": "newData.hasChildren(['at', 'winners', 'votes', 'voters'])",
              "at": {
                ".validate": "newData.isNumber()"
              },
              "winners": {
                "$i": {
                  ".validate": "newData.isString() && newData.parent().parent().parent().child('options/' + newData.val()).exists()"
                }
              },
              "votes": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "voters": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "voters": {
          ".read": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('meetings/' + $code + '/info').exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            "anon": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "ballots": {
          ".read": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$cat": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('meetings/' + $code + '/categories/' + $cat + '/status').val() === 'open' && root.child('meetings/' + $code + '/voters/' + $uid).exists()",
              ".validate": "(!root.child('meetings/' + $code + '/categories/' + $cat + '/multi').exists() && newData.isString() && root.child('meetings/' + $code + '/categories/' + $cat + '/options/' + newData.val()).exists()) || (root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() >= 2 && newData.hasChildren())",
              "$slot": {
                ".validate": "newData.isString() && root.child('meetings/' + $code + '/categories/' + $cat + '/options/' + newData.val()).exists() && (($slot === 's0' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 0) || ($slot === 's1' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 1) || ($slot === 's2' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 2) || ($slot === 's3' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 3) || ($slot === 's4' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 4) || ($slot === 's5' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 5) || ($slot === 's6' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 6) || ($slot === 's7' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 7) || ($slot === 's8' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 8) || ($slot === 's9' && root.child('meetings/' + $code + '/categories/' + $cat + '/multi').val() > 9)) && ($slot === 's0' || newData.parent().child('s0').val() !== newData.val()) && ($slot === 's1' || newData.parent().child('s1').val() !== newData.val()) && ($slot === 's2' || newData.parent().child('s2').val() !== newData.val()) && ($slot === 's3' || newData.parent().child('s3').val() !== newData.val()) && ($slot === 's4' || newData.parent().child('s4').val() !== newData.val()) && ($slot === 's5' || newData.parent().child('s5').val() !== newData.val()) && ($slot === 's6' || newData.parent().child('s6').val() !== newData.val()) && ($slot === 's7' || newData.parent().child('s7').val() !== newData.val()) && ($slot === 's8' || newData.parent().child('s8').val() !== newData.val()) && ($slot === 's9' || newData.parent().child('s9').val() !== newData.val())"
              }
            }
          }
        },
        "feedback": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['status', 'round', 'question'])",
          "status": {
            ".validate": "newData.val() === 'open' || newData.val() === 'closed'"
          },
          "round": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "question": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        },
        "responses": {
          ".read": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
          "$round": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "(auth != null && auth.uid === $uid && !data.exists() && root.child('meetings/' + $code + '/feedback/status').val() === 'open' && root.child('meetings/' + $code + '/feedback/round').val() === $round && root.child('meetings/' + $code + '/voters/' + $uid).exists()) || (!newData.exists() && auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists())",
              ".validate": "newData.hasChildren(['name', 'q', 'at']) && (newData.hasChild('rating') || newData.hasChild('comment'))",
              "name": {
                ".validate": "newData.val() === root.child('meetings/' + $code + '/voters/' + $uid + '/name').val()"
              },
              "q": {
                ".validate": "newData.val() === root.child('meetings/' + $code + '/feedback/question').val()"
              },
              "rating": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
              },
              "comment": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            ".write": "!newData.exists() && auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()"
          }
        },
        "online": {
          ".read": "auth != null && root.child('meetings/' + $code + '/hosts/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        ".write": "!newData.exists() && auth != null && auth.token.email_verified == true && root.child('admins/' + auth.token.email.toLowerCase().replace('.', ',')).exists() && (data.child('hosts/' + auth.uid).exists() || data.child('info/createdAt').val() < now - 2592000000)"
      }
    }
  }
}
